rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Pattern images and PDFs - publicly readable, admin-only upload
    match /patterns/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Sewing machine photos - publicly readable, admin-only upload
    match /sewingMachines/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Website photos uploaded from the photo frames - publicly readable, admin-only upload
    match /sitePhotos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Partner and organisation logos - publicly readable, admin-only upload
    match /partnerLogos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Everything else is denied by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
